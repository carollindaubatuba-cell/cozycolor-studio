{
  "name": "cozycolor-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "build": "tsc --noEmit && npm run check:art && vite build",
    "preview": "vite preview",
    "check:art": "esbuild scripts/check-artworks.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/check-artworks.mjs && node node_modules/.cache/check-artworks.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
